---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const formatDate = (value: string) => new Date(value).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
---

<Layout title="Blog | Irfan Deni" description="A long-term record of what I build and learn">
	<section class="mx-auto max-w-6xl px-5 py-14 sm:px-6 lg:py-20">
		<div class="grid gap-8 border-b-2 border-[var(--ink)] pb-10 md:grid-cols-[1fr_auto] md:items-end">
			<div><p class="eyebrow">Learning log / archive</p><h1 class="mt-4 text-5xl leading-none sm:text-6xl">Writing & notes</h1><p class="mt-5 max-w-xl leading-7 text-[var(--muted)]">A long-term record of what I build, learn, and figure out along the way. Expect build logs, cloud notes, project decisions, and lessons worth keeping.</p></div>
			<a class="btn-secondary" href="mailto:m.irfandeni@gmail.com">Request a topic</a>
		</div>

		<div class="divide-y rule">
			{posts.map((post, index) => (
				<article class="group grid gap-5 py-8 md:grid-cols-[4rem_12rem_minmax(0,1fr)_auto] md:gap-8 md:py-10">
					<span class="font-mono text-xs text-[var(--accent)]">0{index + 1}</span>
					<a class="blog-thumbnail" href={`/blog/${post.id}/`} aria-label={`Read ${post.data.title}`}>
						{post.data.image ? (
							<img src={post.data.image} alt={post.data.imageAlt ?? post.data.title} loading="lazy" />
						) : (
							<span class="blog-thumbnail-fallback" aria-hidden="true"><span>{post.data.category}</span><strong>0{index + 1}</strong></span>
						)}
					</a>
					<div>
						<div class="flex flex-wrap items-center gap-3 font-mono text-xs text-[var(--muted)]"><span class="text-[var(--accent)]">{post.data.category}</span><span>/{formatDate(post.data.date)}</span>{post.data.readingTime && <span>/{post.data.readingTime}</span>}</div>
						<h2 class="mt-4 text-3xl transition group-hover:text-[var(--accent)] sm:text-4xl"><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
						<p class="mt-3 max-w-xl leading-7 text-[var(--muted)]">{post.data.description}</p>
						<div class="mt-5 flex flex-wrap gap-2">{post.data.tags?.map((tag) => <span class="pill">{tag}</span>)}</div>
					</div>
					<a class="btn-ghost self-start md:mt-1" href={`/blog/${post.id}/`}>Read <span aria-hidden="true">→</span></a>
				</article>
			))}
		</div>
	</section>
</Layout>
