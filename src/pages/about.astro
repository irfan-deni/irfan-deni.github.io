---
import Layout from '../layouts/Layout.astro';

const skills = [
	{ category: 'Languages', items: [{ name: 'TypeScript', icon: 'typescript', color: '3178C6' }, { name: 'Java', icon: 'openjdk', color: 'ED8B00' }, { name: 'Python', icon: 'python', color: '3776AB' }, { name: 'Markdown', icon: 'markdown', color: '000000', iconClass: 'skill-icon-invert-dark', badgeClass: 'markdown-skill' }] },
	{ category: 'Cloud & infrastructure', items: [{ name: 'AWS', color: 'FF9900', logo: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/amazonwebservices/amazonwebservices-original-wordmark.svg', badgeClass: 'aws-skill' }, { name: 'Google Cloud', icon: 'googlecloud', color: '4285F4' }, { name: 'Cloudflare', icon: 'cloudflare', color: 'F38020' }, { name: 'Terraform', icon: 'terraform', color: '844FBA' }, { name: 'Docker', icon: 'docker', color: '2496ED' }, { name: 'Ansible', icon: 'ansible', color: 'EE0000' }, { name: 'Linux', icon: 'linux', color: 'FCC624' }] },
	{ category: 'Web & apps', items: [{ name: 'Nuxt', icon: 'nuxt', color: '00DC82' }, { name: 'Vue', icon: 'vuedotjs', color: '4FC08D' }, { name: 'Astro', icon: 'astro', color: 'BC52EE' }, { name: 'Vite', icon: 'vite', color: '646CFF' }, { name: 'Flutter', icon: 'flutter', color: '02569B' }] },
	{ category: 'Data & tools', items: [{ name: 'SQLite', icon: 'sqlite', color: '003B57' }, { name: 'Supabase', icon: 'supabase', color: '3FCF8E' }, { name: 'Figma', icon: 'figma', color: 'F24E1E' }, { name: 'Postman', icon: 'postman', color: 'FF6C37' }, { name: 'Vitest', icon: 'vitest', color: 'FCC72B' }, { name: 'Git', icon: 'git', color: 'F05032' }, { name: 'GitHub Actions', icon: 'githubactions', color: '2088FF' }] },
	{ category: 'Creative tools', items: [{ name: 'Aseprite', icon: 'aseprite', color: '7D929E' }] },
];
---

<Layout title="About | Irfan Deni" description="Background, skills, and focus areas">
	<section class="mx-auto max-w-6xl px-5 py-14 sm:px-6 lg:py-20">
		<p class="eyebrow">Profile / 01</p>
		<div class="mt-5 grid gap-10 lg:grid-cols-[minmax(0,1.3fr)_minmax(16rem,.7fr)]">
			<div>
				<h1 class="text-5xl leading-none sm:text-6xl">Curious by default. Deliberate in practice.</h1>
				<div class="mt-8 max-w-2xl space-y-5 text-lg leading-8 text-[var(--muted)]">
					<p>I enjoy building web applications from the ground up and turning ideas into products people can use. I’m currently working on Inapgo, a SaaS app built with Nuxt, Cloudflare, and Supabase.</p>
					<p>I like learning by building and improving things as I go. I’m especially interested in cloud, DevOps, and the infrastructure behind reliable products. Right now, I’m exploring more of the tools and workflows that make web apps easier to build, ship, and maintain.</p>
				</div>
			</div>
			<div class="border-l-2 border-[var(--accent)] pl-5 font-mono text-xs leading-6 text-[var(--muted)]">I care about the small decisions that make a product feel considered: clear language, fast interfaces, and systems that are pleasant to maintain.</div>
		</div>

		<div class="mt-20 grid gap-12 lg:grid-cols-[minmax(0,1.2fr)_minmax(17rem,.8fr)]">
			<div>
				<div class="flex items-center justify-between border-t-2 border-[var(--ink)] py-4"><h2 class="text-2xl">Timeline</h2><span class="font-mono text-xs text-[var(--muted)]">Selected notes</span></div>
				<div class="divide-y rule">
					<div class="grid gap-2 py-5 sm:grid-cols-[8rem_1fr]"><span class="font-mono text-xs text-[var(--accent)]">In progress</span><p class="text-[var(--muted)]">Placeholder role — What you shipped and who it impacted.</p></div>
					<div class="grid gap-2 py-5 sm:grid-cols-[8rem_1fr]"><span class="font-mono text-xs text-[var(--accent)]">In progress</span><p class="text-[var(--muted)]">Placeholder role — Tech stack, team size, and responsibilities.</p></div>
					<div class="grid gap-2 py-5 sm:grid-cols-[8rem_1fr]"><span class="font-mono text-xs text-[var(--accent)]">In progress</span><p class="text-[var(--muted)]">Placeholder achievement — Performance, reliability, or UX wins.</p></div>
				</div>
			</div>
			<aside class="border-t-2 border-[var(--ink)] pt-4"><p class="eyebrow">Toolbox</p><div class="mt-6 space-y-6">{skills.map((group) => <div class="skill-group"><h3 class="font-mono text-xs font-medium uppercase tracking-[0.1em] text-[var(--ink)]">{group.category}</h3><div class="mt-3 flex flex-wrap gap-2">{group.items.map((item) => <span class:list={['pill', 'skill-pill', item.badgeClass]} style={`--skill-color: #${item.color}`}><img src={item.logo ?? `https://cdn.simpleicons.org/${item.icon}/${item.color}`} class={item.iconClass} alt="" width="14" height="14" loading="lazy" />{item.name}</span>)}</div></div>)}</div></aside>
		</div>
	</section>
</Layout>
