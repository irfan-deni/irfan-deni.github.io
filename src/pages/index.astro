---
import Layout from '../layouts/Layout.astro';

const highlights = [
	{ number: '01', title: 'Web & apps', detail: 'TypeScript, Astro, Nuxt, Vue, Vite, and Flutter for considered interfaces.', tag: 'Interface' },
	{ number: '02', title: 'Cloud & systems', detail: 'AWS, Google Cloud, Cloudflare, Terraform, Docker, Ansible, and Linux.', tag: 'Systems' },
	{ number: '03', title: 'Craft & delivery', detail: 'Testing, automation, design tools, and reliable development workflows.', tag: 'Practice' },
];

const tools = [
	{ name: 'TypeScript', icon: 'typescript', color: '3178C6' },
	{ name: 'Astro', icon: 'astro', color: 'BC52EE' },
	{ name: 'AWS', color: 'FF9900', logo: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/amazonwebservices/amazonwebservices-original-wordmark.svg', badgeClass: 'aws-skill' },
	{ name: 'Cloudflare', icon: 'cloudflare', color: 'F38020' },
	{ name: 'Terraform', icon: 'terraform', color: '844FBA' },
	{ name: 'Docker', icon: 'docker', color: '2496ED' },
];
---

<Layout title="Irfan Deni | Developer Portfolio" description="Developer / Programmer / Tech Enthusiast">
	<section class="mx-auto max-w-6xl px-5 py-14 sm:px-6 lg:py-24">
		<div class="grid gap-12 lg:grid-cols-[minmax(0,1.45fr)_minmax(17rem,.55fr)] lg:gap-20">
			<div>
				<p class="eyebrow">Independent developer / Malaysia</p>
				<h1 class="mt-5 max-w-4xl text-5xl leading-[0.96] sm:text-6xl lg:text-7xl">Building a clearer path through complex systems.</h1>
				<div class="mt-8 max-w-2xl space-y-5 text-base leading-8 text-[var(--muted)] sm:text-lg">
					<p>I build web applications and SaaS products with Nuxt, Cloudflare, and Supabase. I’m interested in cloud and DevOps, with a focus on the systems, infrastructure, and workflows that help products run reliably.</p>
					<p>I’m still figuring things out as I go, but I enjoy building, learning, and turning ideas into something real.</p>
				</div>
				<div class="mt-8 flex flex-wrap gap-3">
					<a class="btn-primary" href="/projects">Selected work <span aria-hidden="true">→</span></a>
					<a class="btn-secondary" href="https://github.com/irfan-deni" target="_blank" rel="noreferrer">GitHub ↗</a>
				</div>
			</div>

			<aside class="border-t-2 border-[var(--ink)] pt-4 lg:mt-4">
				<div class="flex items-center justify-between font-mono text-xs uppercase tracking-[0.1em] text-[var(--muted)]">
					<span>Currently</span><span>08.2026</span>
				</div>
				<p class="mt-12 font-display text-3xl leading-tight">Learning in public, one reliable system at a time.</p>
				<div class="mt-12 border-t rule pt-4">
					<p class="eyebrow">Tools in rotation</p>
					<div class="mt-3 flex flex-wrap gap-2">{tools.map((tool) => <span class:list={['pill', 'skill-pill', tool.badgeClass]} style={`--skill-color: #${tool.color}`}><img src={tool.logo ?? `https://cdn.simpleicons.org/${tool.icon}/${tool.color}`} alt="" width="14" height="14" loading="lazy" />{tool.name}</span>)}</div>
				</div>
			</aside>
		</div>

		<div class="mt-20 border-t-2 border-[var(--ink)]">
			<div class="flex items-baseline justify-between py-5">
				<p class="eyebrow">Areas of practice</p>
				<span class="font-mono text-xs text-[var(--muted)]">03 / 03</span>
			</div>
			<div class="grid border-t rule md:grid-cols-3">
				{highlights.map((item) => (
					<article class="border-b rule py-7 md:border-b-0 md:px-7 md:first:pl-0 md:not(:last-child):border-r">
						<p class="font-mono text-xs text-[var(--accent)]">{item.number} / {item.tag}</p>
						<h2 class="mt-10 text-3xl">{item.title}</h2>
						<p class="mt-3 max-w-xs text-sm leading-6 text-[var(--muted)]">{item.detail}</p>
					</article>
				))}
			</div>
		</div>
	</section>
</Layout>
