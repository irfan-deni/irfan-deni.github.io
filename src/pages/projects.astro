---
import Layout from '../layouts/Layout.astro';

const projects = [
	{ title: 'InapGo', description: 'BotDesk is a platform that helps users manage their tasks efficiently through automation.', tech: ['Python', 'PyQt', 'Tailwind'], links: { repo: '#' } },
	{ title: 'Intra Buddy', description: 'Highlight the problem, your solution, and any notable performance wins.', tech: ['TypeScript', 'React', 'Vite', 'Tailwind CSS', 'Electron'], links: { repo: '#' } },
];
---

<Layout title="Projects | Irfan Deni" description="Selected work and experiments by Irfan Deni">
	<section class="mx-auto max-w-6xl px-5 py-14 sm:px-6 lg:py-20">
		<div class="grid gap-8 border-b-2 border-[var(--ink)] pb-10 md:grid-cols-[1fr_auto] md:items-end">
			<div>
				<p class="eyebrow">Selected work</p>
				<h1 class="mt-4 text-5xl leading-none sm:text-6xl">Projects & experiments</h1>
				<p class="mt-5 max-w-2xl text-base leading-7 text-[var(--muted)]">A working index of things built to make everyday systems more useful, understandable, and dependable.</p>
			</div>
			<a class="btn-secondary" href="https://github.com/irfan-deni" target="_blank" rel="noreferrer">All on GitHub ↗</a>
		</div>

		<div class="divide-y rule">
			{projects.map((project, index) => (
				<article class="group grid gap-5 py-8 md:grid-cols-[4rem_minmax(0,1fr)_auto] md:gap-8 md:py-10">
					<p class="font-mono text-xs text-[var(--accent)]">0{index + 1}</p>
					<div>
						<h2 class="text-3xl transition group-hover:text-[var(--accent)] sm:text-4xl">{project.title}</h2>
						<p class="mt-3 max-w-xl leading-7 text-[var(--muted)]">{project.description}</p>
						<div class="mt-5 flex flex-wrap gap-2">{project.tech.map((tech) => <span class="pill">{tech}</span>)}</div>
					</div>
					<a class="btn-ghost self-start md:mt-1" href={project.links.repo} target="_blank" rel="noreferrer">Repository ↗</a>
				</article>
			))}
		</div>
	</section>
</Layout>
